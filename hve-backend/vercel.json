{
  "buildCommand": "npm run build",
  "regions": ["hkg1"],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/internal/cron/reminders",
      "schedule": "0 2 * * *"
    }
  ]
}
