# ==============================================================================
# HVE Work Backend - Environment Configuration Template (.env.example)
# ==============================================================================
# SAU KHI SAO CHÉP THÀNH .env, BẠN BẮT BUỘC PHẢI THAY ĐỔI CÁC KHÓA BẢO MẬT DƯỚI ĐÂY!
# Hệ thống sẽ FAIL-CLOSED (từ chối khởi động) nếu thiếu JWT_SECRET hoặc VAPID keys.
# ==============================================================================

PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU POSTGRESQL (LEAST PRIVILEGE / BẢO MẬT ĐA TẦNG)
# ------------------------------------------------------------------------------
# DATABASE_URL: Dành cho Backend runtime kết nối. Sau khi chạy script hardening
# (scripts/db_security_hardening.sql), hãy sử dụng tài khoản hve_app_user với quyền
# hạn chế (không được DELETE/UPDATE/TRUNCATE bảng AuditLog).
DATABASE_URL="postgresql://hve_app_user:CHANGE_ME_RUNTIME_PASS@localhost:5432/hve_db?schema=public"

# MIGRATION_DATABASE_URL (hoặc dùng tạm DATABASE_URL khi deploy Prisma migration):
# Cần quyền DDL (sở hữu schema) như hve_user hoặc postgres để chạy `npx prisma migrate deploy`.
MIGRATION_DATABASE_URL="postgresql://hve_user:hve_password@localhost:5432/hve_db?schema=public"

# ------------------------------------------------------------------------------
# 2. XÁC THỰC JWT (BẮT BUỘC - FAIL-CLOSED NẾU THIẾU)
# ------------------------------------------------------------------------------
# Không sử dụng khóa mặc định! Hãy tạo chuỗi ngẫu nhiên bằng lệnh:
# openssl rand -base64 48
JWT_SECRET="CHANGE_ME_GENERATE_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS"

# ------------------------------------------------------------------------------
# 3. WEB PUSH NOTIFICATIONS / VAPID KEYS (BẮT BUỘC - FAIL-CLOSED NẾU THIẾU)
# ------------------------------------------------------------------------------
# Cặp khóa VAPID riêng cho từng môi trường triển khai.
# Tự sinh cặp khóa mới bằng lệnh:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="CHANGE_ME_GENERATE_WITH_NPX_WEB_PUSH_GENERATE_VAPID_KEYS"
VAPID_PRIVATE_KEY="CHANGE_ME_GENERATE_WITH_NPX_WEB_PUSH_GENERATE_VAPID_KEYS"
VAPID_SUBJECT="mailto:admin@huyvoeducation.vn"

# ------------------------------------------------------------------------------
# 4. BẢO VỆ TÀI LIỆU API (SWAGGER /api/docs)
# ------------------------------------------------------------------------------
# Tài liệu Swagger OpenAPI được bảo vệ bằng HTTP Basic Authentication
SWAGGER_USER="admin"
SWAGGER_PASSWORD="CHANGE_ME_STRONG_DOCS_PASSWORD"

# ------------------------------------------------------------------------------
# 5. BẢO MẬT MẠNG & CORS WHITELIST
# ------------------------------------------------------------------------------
# Danh sách domain frontend được phép gọi API (phân tách bởi dấu phẩy)
ALLOWED_ORIGINS="https://app.huyvoeducation.vn,http://localhost:5173"

# ------------------------------------------------------------------------------
# 6. LƯU TRỮ TỆP ĐÍNH KÈM QUA GOOGLE DRIVE (BẮT BUỘC khi chạy trên Vercel
#    serverless — ổ đĩa server không lưu trữ lâu dài giữa các lần gọi hàm)
# ------------------------------------------------------------------------------
# Tạo Service Account trên Google Cloud Console, bật Google Drive API, chia sẻ
# thư mục Drive đích cho email service account với quyền Editor, rồi lấy Folder ID
# từ URL thư mục đó (đoạn cuối URL, sau /folders/).
GOOGLE_SERVICE_ACCOUNT_EMAIL="hve-work-drive@CHANGE_ME_PROJECT.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="CHANGE_ME_DRIVE_FOLDER_ID"

# ------------------------------------------------------------------------------
# 7. VERCEL CRON JOBS (nhắc việc quá hạn tự động — thay cho @Cron nội bộ vì
#    serverless không có tiến trình nền liên tục)
# ------------------------------------------------------------------------------
# Chuỗi bí mật tuỳ ý (ví dụ: openssl rand -hex 32). Khi cấu hình biến này trên
# Vercel, Vercel tự đính kèm header "Authorization: Bearer <CRON_SECRET>" cho
# mọi lệnh gọi Cron Jobs của chính project đó.
CRON_SECRET="CHANGE_ME_GENERATE_RANDOM_SECRET"

# ------------------------------------------------------------------------------
# 8. XÁC MINH EMAIL KHI ĐĂNG NHẬP LẦN ĐẦU / THIẾT BỊ LẠ
# ------------------------------------------------------------------------------
# Chỉ bật sau khi đã kiểm tra SMTP gửi thư thành công. Khi bật mà SMTP thiếu,
# hệ thống fail-closed ở bước đăng nhập và không cấp JWT.
LOGIN_EMAIL_OTP_ENABLED=false
RESEND_API_KEY="re_CHANGE_ME"
EMAIL_FROM="HVE Work <no-reply@auth.huyvoeducation.vn>"
# SMTP is a fallback for environments where outbound SMTP is available.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="admin@huyvoeducation.vn"
SMTP_PASS="CHANGE_ME_SMTP_PASSWORD"
